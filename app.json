{
  "expo": {
    "newArchEnabled": true,
    "name": "Pulse FC",
    "slug": "dugout-fc",
    "version": "1.3.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pulsefc",
    "splash": {
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulsefc.mobile",
      "appleTeamId": "5U6J5AR2B4",
      "associatedDomains": [
        "applinks:pulse-fc.app",
        "applinks:www.pulse-fc.app"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Used to upload your profile photo and club logo.",
        "NSCameraUsageDescription": "Used to take a profile photo.",
        "NSLocationWhenInUseUsageDescription": "Used to show driving time to event locations.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.pulsefc.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Pulse FC",
      "shortName": "Pulse FC",
      "display": "standalone",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show driving time to event locations."
        }
      ],
      "expo-splash-screen",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "defaultChannel": "default",
          "iosDisplayInForeground": true
        }
      ],
      "expo-sharing",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b35d5d3-278b-42c4-b66b-1a487815ce31"
      }
    }
  }
}
